{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Amsterdam",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "automerge": false,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group routine Go and action updates for reviewed maintenance.",
      "matchManagers": ["gomod", "github-actions"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "groupName": "routine dependencies"
    },
    {
      "description": "Keep major updates independently reviewable.",
      "matchManagers": ["gomod", "github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "major dependency updates"
    },
    {
      "description": "Security alerts bypass the normal release cooling period but never auto-merge.",
      "matchDatasources": ["osv"],
      "minimumReleaseAge": "0 days",
      "automerge": false
    }
  ]
}
